<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="CloudWay_LMS.Masterpages.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> | CloudWay LMS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&family=Poppins:wght@600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%= ResolveUrl("~/Content/site.css?v=9") %>" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="frmMain" runat="server">


        <header class="site-header">
            <div class="container header-inner">
                <a href="<%= ResolveUrl("~/Pages/Default.aspx") %>" class="brand">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 140 36" width="140" height="36" fill="none">
                      <path d="M12 24C9.79 24 8 22.21 8 20C8 18.04 9.42 16.42 11.31 16.07C11.83 12.65 14.77 10 18.33 10C21.1 10 23.51 11.61 24.63 13.96C25.43 13.35 26.42 13 27.5 13C29.98 13 32 15.02 32 17.5C32 17.84 31.96 18.17 31.89 18.49C33.68 19.18 35 20.94 35 23C35 25.76 32.76 28 30 28H14" stroke="#13A89E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M17 21L21 17L25 21" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <text x="44" y="24" font-family="'Poppins', sans-serif" font-weight="600" font-size="18" fill="#FFFFFF" letter-spacing="-0.01em">Cloud<tspan fill="#13A89E">Way</tspan></text>
                    </svg>
                </a>
            </div>
        </header>

        <nav class="site-nav" aria-label="Primary">
            <div class="container" style="display:flex; justify-content:space-between; align-items:center;">
                <ul class="nav-list" style="margin:0;">
                    <li><a href="<%= ResolveUrl("~/Pages/Default.aspx") %>">Home</a></li>
                    <li><a href="<%= ResolveUrl("~/Pages/Courses.aspx") %>">Courses</a></li>
                    
                    <% if (CloudWay_LMS.BLL.AuthBLL.IsLoggedIn) { %>
                        <li><a href="<%= ResolveUrl("~/Member/MyLearning.aspx") %>">My Learning</a></li>
                    <% } %>
                </ul>

                <ul class="nav-list" style="margin:0;">
                    <asp:PlaceHolder ID="phGuest" runat="server">
                        <li><a href="<%= ResolveUrl("~/Account/Login.aspx") %>">Login</a></li>
                        <li><a class="btn-nav" href="<%= ResolveUrl("~/Account/Register.aspx") %>">Register</a></li>
                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="phLoggedIn" runat="server" Visible="false">
                        <li class="nav-dropdown">
                            <button class="btn-profile" type="button" style="display:flex; align-items:center; gap:8px;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                Hi, <asp:Literal ID="litWelcome" runat="server" />
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </button>
                            <div class="nav-dropdown-menu">
                                <asp:PlaceHolder ID="phAdmin" runat="server" Visible="false">
                                    <a href="<%= ResolveUrl("~/Admin/Dashboard.aspx") %>">Admin Dashboard</a>
                                </asp:PlaceHolder>
                                <a href="<%= ResolveUrl("~/Account/Profile.aspx") %>">My Profile</a>
                                <asp:LinkButton ID="lnkLogout" runat="server" OnClick="lnkLogout_Click" CausesValidation="false">Logout</asp:LinkButton>
                            </div>
                        </li>
                    </asp:PlaceHolder>
                </ul>
            </div>
        </nav>

        <div class="breadcrumb-bar container">
            <asp:SiteMapPath ID="SiteMapPath1" runat="server"
                             PathSeparator=" &rsaquo; " RenderCurrentNodeAsLink="false" SkipLinkText=""
                             CurrentNodeStyle-CssClass="breadcrumb-current" />
        </div>

        <main id="main" class="container site-main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <footer class="site-footer">
            <div class="container footer-grid">
                <section style="padding-right:2rem; grid-column: span 2;">
                    <a href="<%= ResolveUrl("~/Pages/Default.aspx") %>" style="display:inline-block; margin-bottom:1rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 140 36" width="140" height="36" fill="none">
                          <path d="M12 24C9.79 24 8 22.21 8 20C8 18.04 9.42 16.42 11.31 16.07C11.83 12.65 14.77 10 18.33 10C21.1 10 23.51 11.61 24.63 13.96C25.43 13.35 26.42 13 27.5 13C29.98 13 32 15.02 32 17.5C32 17.84 31.96 18.17 31.89 18.49C33.68 19.18 35 20.94 35 23C35 25.76 32.76 28 30 28H14" stroke="#13A89E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M17 21L21 17L25 21" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          <text x="44" y="24" font-family="'Poppins', sans-serif" font-weight="600" font-size="18" fill="#FFFFFF" letter-spacing="-0.01em">Cloud<tspan fill="#13A89E">Way</tspan></text>
                        </svg>
                    </a>
                    <p style="opacity:.7; font-size:.9rem; line-height:1.6; margin-bottom:1.5rem; max-width: 300px;">Empowering the next generation of cloud engineers with state-of-the-art interactive learning.</p>
                </section>
                <section>
                    <h3>Explore</h3>
                    <ul>
                        <li><a href="<%= ResolveUrl("~/Pages/Courses.aspx") %>">All Courses</a></li>
                        <li><a href="<%= ResolveUrl("~/Account/Login.aspx") %>">Student Portal</a></li>
                        <li><a href="<%= ResolveUrl("~/Pages/Contact.aspx") %>">Contact Us</a></li>
                    </ul>
                </section>
                <section>
                    <h3>Legal</h3>
                    <ul>
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="#">Terms of Service</a></li>
                    </ul>
                    <div style="display:flex; gap:1rem; margin-top:1.5rem;">
                        <a href="#" style="opacity:0.7; transition:opacity 0.2s;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a>
                        <a href="#" style="opacity:0.7; transition:opacity 0.2s;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg></a>
                        <a href="#" style="opacity:0.7; transition:opacity 0.2s;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a>
                    </div>
                </section>
            </div>
            <div class="container" style="border-top: 1px solid rgba(255,255,255,0.1); padding: 1.5rem 1rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
                <p style="margin:0; opacity:0.6; font-size:0.9rem;">&copy; <%= DateTime.Now.Year %> CloudWay LMS. All rights reserved.</p>
                <div style="opacity:0.6; font-size:0.9rem;">
                    Made with <span style="color: #e25555;">&hearts;</span> by Group_A
                </div>
            </div>
        </footer>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var elements = document.querySelectorAll('[onclick*="return confirm"]');
            for (var i = 0; i < elements.length; i++) {
                (function(el) {
                    var onclickRaw = el.getAttribute('onclick');
                    var match = onclickRaw.match(/confirm\(([^)]+)\)/);
                    if (match) {
                        var message = match[1].replace(/['"]|&#39;|&quot;/g, '');
                        el.removeAttribute('onclick');
                        el.addEventListener('click', function (e) {
                            e.preventDefault();
                            e.stopPropagation();
                            Swal.fire({
                                title: 'Please Confirm',
                                text: message,
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#0056b3',
                                cancelButtonColor: '#6c757d',
                                confirmButtonText: 'Yes, proceed'
                            }).then(function(result) {
                                if (result.isConfirmed) {
                                    var href = el.getAttribute('href');
                                    if (href && href.indexOf('javascript:') === 0) {
                                        eval(href.substring(11));
                                    } else if (href) {
                                        window.location.href = href;
                                    } else {
                                        var form = el.closest('form');
                                        if (form) form.submit();
                                    }
                                }
                            });
                        });
                    }
                })(elements[i]);
            }
        });

        function togglePassword(btn) {
            const input = btn.previousElementSibling;
            if (!input) return;
            
            if (input.type === 'password') {
                input.type = 'text';
                btn.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';
            } else {
                input.type = 'password';
                btn.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
            }
        }
    </script>
    <script>
        // Convert native select elements to modern custom dropdowns
        document.addEventListener('DOMContentLoaded', function () {
            const selects = document.querySelectorAll('select.form-control');
            selects.forEach(select => {
                // Hide the native select
                select.style.display = 'none';

                // Create wrapper
                const wrapper = document.createElement('div');
                wrapper.className = 'custom-select-wrapper';
                select.parentNode.insertBefore(wrapper, select);
                wrapper.appendChild(select);

                // Create trigger button
                const trigger = document.createElement('div');
                trigger.className = 'custom-select-trigger form-control';
                trigger.innerHTML = `<span>${select.options[select.selectedIndex]?.text || ''}</span>
                                     <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.6;"><polyline points="6 9 12 15 18 9"></polyline></svg>`;
                wrapper.appendChild(trigger);

                // Create dropdown menu
                const menu = document.createElement('div');
                menu.className = 'custom-select-menu';
                
                Array.from(select.options).forEach((option, index) => {
                    const item = document.createElement('div');
                    item.className = 'custom-select-option' + (index === select.selectedIndex ? ' selected' : '');
                    item.textContent = option.text;
                    item.dataset.value = option.value;
                    
                    item.addEventListener('click', function (e) {
                        e.stopPropagation();
                        // Update select value
                        select.selectedIndex = index;
                        trigger.querySelector('span').textContent = option.text;
                        
                        // Update selected class
                        menu.querySelectorAll('.custom-select-option').forEach(opt => opt.classList.remove('selected'));
                        this.classList.add('selected');
                        
                        // Close menu
                        wrapper.classList.remove('open');
                        
                        // Trigger ASP.NET postback or change event
                        select.dispatchEvent(new Event('change', { bubbles: true }));
                    });
                    menu.appendChild(item);
                });
                wrapper.appendChild(menu);

                // Toggle menu
                trigger.addEventListener('click', function (e) {
                    e.stopPropagation();
                    document.querySelectorAll('.custom-select-wrapper').forEach(w => {
                        if (w !== wrapper) w.classList.remove('open');
                    });
                    wrapper.classList.toggle('open');
                });
            });

            // Close when clicking outside
            document.addEventListener('click', function () {
                document.querySelectorAll('.custom-select-wrapper').forEach(w => w.classList.remove('open'));
            });
        });
    </script>
</body>
</html>
