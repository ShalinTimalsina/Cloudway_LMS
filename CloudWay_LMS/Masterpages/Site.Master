<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="CloudWay_LMS.Masterpages.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> | CloudWay LMS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&family=Poppins:wght@600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%= ResolveUrl("~/Content/site.css") %>" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="frmMain" runat="server">


        <header class="site-header">
            <div class="container header-inner">
                <a href="<%= ResolveUrl("~/Pages/Default.aspx") %>" class="brand">
                    <span class="brand-text">CloudWay LMS</span>
                </a>
            </div>
        </header>

        <nav class="site-nav" aria-label="Primary">
            <div class="container">
                <ul class="nav-list">
                    <li><a href="<%= ResolveUrl("~/Pages/Default.aspx") %>">Home</a></li>
                    <li><a href="<%= ResolveUrl("~/Pages/Courses.aspx") %>">Courses</a></li>

                    <asp:PlaceHolder ID="phGuest" runat="server">
                        <li><a href="<%= ResolveUrl("~/Account/Login.aspx") %>">Login</a></li>
                        <li><a class="btn-nav" href="<%= ResolveUrl("~/Account/Register.aspx") %>">Register</a></li>
                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="phLoggedIn" runat="server" Visible="false">
                        <li><a href="<%= ResolveUrl("~/Member/MyLearning.aspx") %>">My Learning</a></li>
                        <li><a href="<%= ResolveUrl("~/Account/Profile.aspx") %>">Profile</a></li>
                        <li><span class="nav-welcome">Hi, <asp:Literal ID="litWelcome" runat="server" /></span></li>
                        <asp:PlaceHolder ID="phAdmin" runat="server" Visible="false">
                            <li><a href="<%= ResolveUrl("~/Admin/ManageCategories.aspx") %>">Admin</a></li>
                        </asp:PlaceHolder>
                        <li>
                            <asp:LinkButton ID="lnkLogout" runat="server" OnClick="lnkLogout_Click"
                                            CausesValidation="false">Logout</asp:LinkButton>
                        </li>
                    </asp:PlaceHolder>
                </ul>
            </div>
        </nav>

        <div class="breadcrumb-bar container">
            <asp:SiteMapPath ID="SiteMapPath1" runat="server"
                             PathSeparator=" &rsaquo; " RenderCurrentNodeAsLink="false" SkipLinkText=""
                             CurrentNodeStyle-CssClass="breadcrumb-current" />
        </div>

        <main id="main" class="container site-main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <footer class="site-footer">
            <div class="container footer-grid">
                <section>
                    <h3>CloudWay Learning</h3>
                    <p style="opacity:.8; font-size:.85rem;">Elevate your cloud skills today.</p>
                </section>
                <section>
                    <h3>Quick links</h3>
                    <ul>
                        <li><a href="<%= ResolveUrl("~/Pages/Courses.aspx") %>">All courses</a></li>
                        <li><a href="<%= ResolveUrl("~/Pages/Contact.aspx") %>">Contact us</a></li>
                    </ul>
                </section>
            </div>
            <p class="footer-copy">&copy; <%= DateTime.Now.Year %> CloudWay LMS</p>
        </footer>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var elements = document.querySelectorAll('[onclick*="return confirm"]');
            for (var i = 0; i < elements.length; i++) {
                (function(el) {
                    var onclickRaw = el.getAttribute('onclick');
                    var match = onclickRaw.match(/confirm\(([^)]+)\)/);
                    if (match) {
                        var message = match[1].replace(/['"]|&#39;|&quot;/g, '');
                        el.removeAttribute('onclick');
                        el.addEventListener('click', function (e) {
                            e.preventDefault();
                            Swal.fire({
                                title: 'Please Confirm',
                                text: message,
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#0056b3',
                                cancelButtonColor: '#6c757d',
                                confirmButtonText: 'Yes, proceed'
                            }).then(function(result) {
                                if (result.isConfirmed) {
                                    var href = el.getAttribute('href');
                                    if (href && href.indexOf('javascript:') === 0) {
                                        eval(href.substring(11));
                                    } else if (href) {
                                        window.location.href = href;
                                    } else {
                                        var form = el.closest('form');
                                        if (form) form.submit();
                                    }
                                }
                            });
                        });
                    }
                })(elements[i]);
            }
        });
    </script>
</body>
</html>
